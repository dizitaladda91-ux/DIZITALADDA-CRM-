NODE_ENV=development
PORT=5000

# Neon Console > Connect > Connection string. Prefer the pooled URL whose host
# contains -pooler for deployed application traffic.
DATABASE_URL=postgresql://<user>:<password>@ep-<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
DB_SSL=true
DB_POOL_MAX=5

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
EMPLOYEE_CODE_PREFIX=EMP
